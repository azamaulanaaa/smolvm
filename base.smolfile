cpus = 1
memory = 512
net = true
storage = 1
overlay = 1 
image = "alpine"
entrypoint = ["bash"]

[dev]
env = [
  "MISE_ALL_COMPILE=false",
]
workdir = "/workspace"
init = [
  "apk add --no-cache curl bash git",
  "curl -fsSL https://mise.run/bash | sh",
  "git config --global --add safe.directory /workspace",
]
